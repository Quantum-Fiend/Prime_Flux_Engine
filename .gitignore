# .gitignore for PrimeFlux Engine

# C++ Build artifacts
core/build/
core/bin/
core/lib/
*.exe
*.dll
*.so
*.dylib
*.a
*.lib
*.obj
*.o

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

# Rust
serialization/target/
serialization/Cargo.lock

# Python
ai/__pycache__/
ai/*.pyc
ai/*.pyo
ai/*.pyd
ai/.Python
ai/venv/
ai/env/

# C# / .NET
editor/bin/
editor/obj/
editor/*.user
editor/*.suo

# TypeScript / Node
dashboard/node_modules/
dashboard/dist/
dashboard/.vite/
dashboard/package-lock.json

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
