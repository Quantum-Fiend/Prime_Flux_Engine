<Application x:Class="PrimeFlux.Editor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="PrimaryBrush" Color="#6366f1"/>
            <SolidColorBrush x:Key="BackgroundBrush" Color="#0f172a"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="#1e293b"/>
            <SolidColorBrush x:Key="TextBrush" Color="#e2e8f0"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
